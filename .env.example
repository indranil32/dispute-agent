# Copy to .env and fill in. Never commit .env.

# ---- Adapters: demo values shown; production values in comments ----
MAILBOX_BACKEND=local        # graph
LLM_BACKEND=heuristic        # azure_openai
SOA_BACKEND=mock             # http
AGENT_MODE=assist            # shadow | assist | autonomous

DB_PATH=./data/disputes.db
LOG_LEVEL=INFO
REVIEW_API_KEY=              # optional extra guard on the review API (use Entra ID auth in front of it)

# ---- Microsoft Graph (Exchange Online) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=         # prefer a certificate / managed identity in Azure Key Vault
MAILBOX_ADDRESS=Dispute.Ports@adports.ae
GRAPH_PROCESSED_FOLDER=Agent-Processed
GRAPH_WEBHOOK_CLIENT_STATE=  # random secret echoed back by Graph notifications

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=        # leave empty to use managed identity
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- SOA layer (Oracle SOA Suite / OIC) ----
SOA_BASE_URL=https://soa.internal.example/dispute-agent/v1
SOA_TOKEN_URL=
SOA_CLIENT_ID=
SOA_CLIENT_SECRET=
SOA_SCOPE=
SOA_TIMEOUT_S=20
